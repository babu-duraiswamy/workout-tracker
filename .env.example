# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres. Use your `dev` branch locally and the `main` branch in Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js. Generate with: npx auth secret (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
# Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated Google emails allowed to sign in (both of you)
ALLOWED_EMAILS="you@example.com,partner@example.com"
